      "description": "Navy action for entering or refreshing an account.",
      "html": "<button class=\"ds-primary\" type=\"button\">Entrar</button>",
      "css": ".ds-primary{min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:12px 18px;border:1px solid transparent;border-radius:var(--radius-control);font:500 var(--text-md)/1.4 var(--font-sans);cursor:pointer;background:var(--color-primary);color:var(--color-on-primary);}.ds-primary:hover:not(:disabled){background:var(--color-primary-hover);}.ds-primary:focus-visible{outline:2px solid var(--color-text);outline-offset:4px;}.ds-primary:disabled{opacity:.65;cursor:wait;}",
      "refersTo": "button-primary"
    },
