  "narrative": {
    "northStar": "Guide neutrals, navy actions, and precise outlines",
    "overview": "The shared Module 6 guide provides the visual authority: cool neutral surfaces, navy actions, Inter typography, and precise outlines. Calm spacing and clear text hierarchy support brief authentication tasks.\n\nLight and dark themes change neutral surfaces, borders, and text while keeping the action palette stable. Depth comes from surface contrast and borders. The module is identified through text; its lock symbol is a functional identifier rather than an official logo.",
    "keyCharacteristics": [
      "Cool neutral surfaces with navy primary actions.",
      "Inter at weights 400, 500, and 600.",
      "Outlined controls, gently curved panels, and visible keyboard focus.",
      "Theme-aware neutrals and text-supported status feedback."
    ],
    "rules": [
      {
        "name": "Action Color",
        "body": "Use navy for primary actions. Reserve critical red for error outlines; never use red for action buttons.",
        "section": "colors"
      },
      {
        "name": "Stable Contrast",
        "body": "Keep on-primary white in both themes; theme switches change neutral tokens, not navy-button foregrounds.",
        "section": "colors"
      },
      {
        "name": "Readable Floor",
        "body": "Keep visible text at 12px or above and use Inter at weights 400, 500, and 600.",
        "section": "typography"
      },
      {
        "name": "Outlined Depth",
        "body": "Use surface contrast and borders for depth; panels and controls do not use box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reference the existing CSS custom properties for reusable visual decisions.",
      "Do preserve white on-primary text and icons in both themes.",
      "Do preserve visible labels, keyboard focus, and text or icons alongside status colors.",
      "Do use the established spacing scale, comfortable mobile gutters, and touch-sized controls.",
      "Do honor reduced-motion preferences and keep motion brief and local to state changes."
    ],
    "donts": [
      "Don't use red for action buttons or communicate status through color alone.",
      "Don't add box shadows or decorative elevation to these outlined surfaces.",
      "Don't shrink visible text below 12px or replace Inter with a system display face.",
      "Don't treat the lock symbol as an official logo or invent additional brand assets.",
      "Don't turn the authentication panel composition into a mandatory layout for unrelated surfaces."
    ]
  }
