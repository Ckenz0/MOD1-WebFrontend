      "refersTo": "button-secondary"
    },
    {
      "name": "Theme Button",
      "kind": "button",
      "description": "Outlined header theme control.",
      "html": "<button class=\"ds-theme\" type=\"button\" aria-label=\"Ativar tema escuro\"><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M20 14a8 8 0 0 1-10-10A8 8 0 1 0 20 14Z\"/></svg><span>Tema escuro</span></button>",
      "css": ".ds-theme{padding:10px 12px;min-height:44px;display:flex;align-items:center;gap:var(--space-xs);color:var(--color-text-muted);background:transparent;border:1px solid var(--color-border);border-radius:var(--radius-control);font:500 var(--text-sm)/1.6 var(--font-sans);cursor:pointer;}.ds-theme svg{width:20px;height:20px;flex-shrink:0;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}.ds-theme:hover{color:var(--color-text);background:var(--color-surface);}.ds-theme:focus-visible{outline:2px solid var(--color-text);outline-offset:4px;}@media(max-width:600px){.ds-theme span{display:none;}}",
