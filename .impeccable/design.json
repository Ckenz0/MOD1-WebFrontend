      "html": "<label class=\"ds-label\" for=\"ds-email\">E-mail</label><input class=\"ds-input\" id=\"ds-email\" type=\"email\" autocomplete=\"username\" placeholder=\"voce@exemplo.com\">",
      "css": ".ds-label{display:block;margin-bottom:var(--space-xs);color:var(--color-text);font:500 var(--text-sm)/1.6 var(--font-sans);}.ds-input{width:100%;min-width:0;height:48px;padding:12px var(--space-sm);color:var(--color-text);caret-color:var(--color-text);background:var(--color-surface);border:1px solid var(--color-text-muted);border-radius:var(--radius-control);font:400 var(--text-sm)/1.6 var(--font-sans);}.ds-input::placeholder{color:var(--color-text-muted);opacity:1;}.ds-input:hover{border-color:var(--color-text);}.ds-input:focus-visible{outline:2px solid var(--color-text);outline-offset:4px;}",
